# Python build / cache artifacts (regenerated automatically)
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Editor / OS cruft
.DS_Store
*.swp

# Personal Claude Code settings (not meant to be shared)
.claude/settings.local.json

# Secrets: env files, API keys, credentials
.env
.env.*
*.env
*.key
*.pem
credentials.json
secrets.json
kcoder-token*

# kcoder daemon local data (sessions, transcripts, token, logs) if ever
# pointed at a directory inside the repo
.kcoder/
kcoder-data/
data/
sessions/
*.jsonl
*.log
daemon.json

# Node (web UI tooling, if any)
node_modules/

# relay local secrets
relay/.dev.vars
relay/.wrangler/
